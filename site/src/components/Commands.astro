---
import RiskBadge from "./RiskBadge.astro";

// From plugin/actions/*.js: the command each action runs, its risk, and
// what it costs.
const COMMANDS = [
  {
    label: "pnpm store",
    command: "pnpm store prune",
    risk: "safe",
    note: "Removes packages no project references.",
  },
  {
    label: "Docker build cache",
    command: "docker builder prune -a -f",
    risk: "safe",
    note: "The next build of each image starts with no cache.",
  },
  {
    label: "Docker dangling images",
    command: "docker image prune -f",
    risk: "safe",
    note: "Removes untagged images that no container uses.",
  },
  {
    label: "WSL disks",
    command: "wsl --shutdown, then diskpart compact vdisk",
    risk: "caution",
    note: "Each disk shrinks to what it holds. WSL and Docker stop while it runs.",
  },
  {
    label: "Windows component store",
    command: "DISM /Online /Cleanup-Image /StartComponentCleanup",
    risk: "caution",
    note: "Slow. Old updates can no longer be uninstalled.",
  },
] as const;
---

<section class="wrap section" aria-labelledby="commands">
  <h2 id="commands">Cleans with the tool's own command</h2>
  <p class="lead">For these, riptide runs the tool's cleanup instead of deleting folders.</p>

  <ul class="commands">
    {
      COMMANDS.map((c) => (
        <li class="panel">
          <div class="top">
            <h3>{c.label}</h3>
            <RiskBadge risk={c.risk} />
          </div>
          <code>{c.command}</code>
          <p class="dim">{c.note}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .commands {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }

  .commands li {
    padding: var(--s-4) var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
  }

  h3 {
    margin: 0;
    font-size: var(--fs-title);
  }

  code {
    color: var(--current);
  }

  p {
    margin: 0;
    font-size: var(--fs-body);
  }
</style>
