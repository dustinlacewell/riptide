---
import WaveMark from "./WaveMark.astro";
import Telemetry from "./Telemetry.astro";
import Demo from "./Demo.jsx";
---

<header class="hero">
  <div class="wrap copy">
    <div class="topbar">
      <div class="wordmark">
        <WaveMark size={36} />
        <span>riptide</span>
      </div>
      {/* TODO: point "Get riptide" at the source repo once its URL is public. */}
      <a class="cta" href="#get">Get riptide</a>
    </div>
    <h1>Find build junk across a drive. Uncheck what you keep. Delete the rest.</h1>
    <p class="lead">
      A disk cleaner for Windows developers. Below is the real app on a made-up drive. Press Scan.
    </p>
  </div>

  <!-- The app window scales down to about 900 px. Narrower screens get the
       figure instead.
       The app renders only in the browser; Astro shows the fallback figure
       until it mounts. -->
  <div class="stage wide">
    <Demo client:load />
  </div>
  <div class="wrap narrow">
    <Telemetry />
    <p class="dim">Open on a wider screen to try the demo.</p>
  </div>
</header>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
    padding-top: var(--s-5);
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    align-items: flex-start;
    width: 100%;
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    width: 100%;
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--current);
  }

  .wordmark span {
    color: var(--text);
    font-size: var(--fs-stat);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  h1 {
    margin: 0;
    max-width: 24ch;
    font-size: clamp(32px, 5vw, 44px);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  .lead {
    margin: 0;
    color: var(--dim);
    font-size: var(--fs-lead);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 var(--s-5);
    border-radius: var(--r-md);
    background: var(--current);
    color: var(--on-accent);
    font-size: var(--fs-title);
    font-weight: 700;
    text-decoration: none;
    transition: filter var(--t-quick) var(--ease-out);
  }

  .cta:hover {
    filter: brightness(1.08);
  }

  /* Wider than the text column: the app is the point of the page. At full
     width the app window (Demo.jsx, 1200 px) fills it exactly; narrower,
     the window scales down. */
  .stage {
    width: 100%;
    max-width: calc(var(--site-width) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* A fixed-size window: it never grows with its content. */
  .stage :global(.demo-app) {
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    overflow: hidden;
  }

  .narrow {
    display: none;
  }

  .narrow p {
    margin: var(--s-3) 0 0;
  }

  @media (max-width: 899px) {
    .wide {
      display: none;
    }

    .narrow {
      display: block;
    }

    .hero {
      gap: var(--s-5);
      padding-top: var(--s-6);
    }
  }
</style>
